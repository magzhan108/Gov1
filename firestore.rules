rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Пайдаланушылар кестесі (Рөлдерді қауіпсіз сақтау)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Тек әкімші өз рөлін немесе басқаларды өзгерте алады
      allow update: if request.auth != null && 
        (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Мәселелер мен хабарламалар (Reports)
    match /reports/{reportId} {
      // 1. Барлық адамдар мәселелерді оқи алады
      allow read: if true;
      
      // 2. Мәселені жүйеге кірген қолданушылар жібере алады
      allow create: if request.auth != null;
      
      // 3. Статусты өзгерту немесе жою тек Әкімшілікке (admin) рұқсат
      // Немесе өз жазған мәселесін жою авторына рұқсат
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        resource.data.userId == request.auth.uid
      );
    }
  }
}
